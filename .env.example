# Public site URL (sitemap, robots, Open Graph, JSON-LD, payment callbacks, cron links)
# REQUIRED in production (or set NEXT_PUBLIC_APP_URL / APP_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — REQUIRED in production
DATABASE_URL=postgresql://user:password@localhost:5432/niloora

# Auth — REQUIRED (server fails startup if missing)
SESSION_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=3

# SMS (production) — Kavenegar
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
# نام قالب Verify Lookup در پنل کاوه‌نگار (متغیر %token)
KAVENEGAR_OTP_TEMPLATE=verify
# خط ارسال برای fallback پیام متنی (اختیاری)
KAVENEGAR_SENDER=
# قالب‌های Lookup سفارش (اختیاری؛ token=شماره سفارش، token2=مبلغ/رهگیری)
KAVENEGAR_TEMPLATE_ORDER_PLACED=
KAVENEGAR_TEMPLATE_ORDER_SHIPPED=

# اعلان سفارش (SMS + ایمیل اختیاری)
NOTIFY_ENABLED=true
NOTIFY_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com

# Abandoned cart recovery reminders
ABANDONED_CART_ENABLED=true
ABANDONED_CART_REMINDER_DELAY_MINUTES=120
# REQUIRED in production — shared secret for POST /api/cron/*
# Header: x-cron-secret: <value>
# See docs/production.md
ABANDONED_CART_CRON_SECRET=
# Optional: retries inventory commit for paid orders (defaults to CRON_SECRET / ABANDONED_CART_CRON_SECRET)
INVENTORY_RETRY_CRON_SECRET=
# Marketplace catalog filter (default OFF — preserves full D2C catalog)
ENABLE_MARKETPLACE_FILTER=false
# Marketplace catalog ranking (default OFF — legacy sort order)
ENABLE_MARKETPLACE_RANKING=false
# Search backend: local (default) | typesense (future)
SEARCH_PROVIDER=local
# Default vendor commission in basis points (1000 = 10%)
VENDOR_DEFAULT_COMMISSION_BPS=1000

# Payments (merchant can also be set in admin site settings)
ZARINPAL_MERCHANT_ID=
# Set false for live payments in production
ZARINPAL_SANDBOX=true

# Optional health probe hardening (detailed mode)
# GET /api/health?detailed=1 + header x-health-secret
HEALTH_CHECK_SECRET=

# Observability (Sentry + structured logs)
# Set SENTRY_ENABLED=false to skip DSN requirement warnings
# SENTRY_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=
# SENTRY_TUNNEL_ROUTE=/monitoring
