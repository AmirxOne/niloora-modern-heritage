# Public site URL (sitemap, robots, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/niloora

# Auth
SESSION_SECRET=change-me-to-a-long-random-string
OTP_TTL_MINUTES=3

# SMS (production) — Kavenegar
SMS_PROVIDER=kavenegar
KAVENEGAR_API_KEY=
# نام قالب Verify Lookup در پنل کاوه‌نگار (متغیر %token)
KAVENEGAR_OTP_TEMPLATE=verify
# خط ارسال برای fallback پیام متنی (اختیاری)
KAVENEGAR_SENDER=
# قالب‌های Lookup سفارش (اختیاری؛ token=شماره سفارش، token2=مبلغ/رهگیری)
KAVENEGAR_TEMPLATE_ORDER_PLACED=
KAVENEGAR_TEMPLATE_ORDER_SHIPPED=

# اعلان سفارش (SMS + ایمیل اختیاری)
NOTIFY_ENABLED=true
NOTIFY_EMAIL_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com

# Abandoned cart recovery reminders
ABANDONED_CART_ENABLED=true
ABANDONED_CART_REMINDER_DELAY_MINUTES=120
# Required for calling /api/cron/abandoned-cart-recovery from scheduler
ABANDONED_CART_CRON_SECRET=

# Payments
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Observability (Sentry + structured logs)
# SENTRY_ENABLED=false
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_RELEASE=
# SENTRY_TUNNEL_ROUTE=/monitoring
