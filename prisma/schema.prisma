generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String               @id @default(cuid())
  name          String
  phone         String               @unique
  referralCode  String               @unique
  signupIpHash  String?
  referredById  String?
  referredBy    User?                @relation("UserReferralTree", fields: [referredById], references: [id], onDelete: SetNull)
  referredUsers User[]               @relation("UserReferralTree")
  referralCredit Int                 @default(0)
  referralEarnedTotal Int            @default(0)
  loyaltyPoints   Int                @default(0)
  loyaltyTier     String             @default("bronze")
  loyaltyLifetimeSpend Int           @default(0)
  passwordHash  String
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  postalCode    String?
  addressLine   String?
  province      String?
  city          String?
  nationalCode  String?
  landlinePhone String?
  gender        String?
  favoriteStone String?
  favoriteStyle String?
  favoriteBudgetBand String?
  role          String               @default("user")
  blocked       Boolean              @default(false)
  memberSince   DateTime             @default(now())
  tier          String?
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  email         String?              @unique
  journeyEvents AutomatedJourneyEvent[]
  maintenanceReminders MaintenanceReminder[]
  priceDropUnsubscribeTokens PriceDropUnsubscribeToken[]
  orders                 Order[]
  supportRequests        SupportRequest[]
  orderReturns           OrderReturn[]
  customizerQuoteRequests CustomizerQuoteRequest[]
  comments               ProductComment[]
  productQuestions       ProductQuestion[]
  productQuestionAnswers ProductQuestionAnswer[]
  ugcMedia              ProductUgcMedia[]
  backInStockAlerts      BackInStockAlert[]
  abandonedCartRecoveries AbandonedCartRecovery[]
  referralInvitesSent    ReferralInvite[]   @relation("ReferralInviter")
  referralInviteReceived ReferralInvite[]   @relation("ReferralInvitee")
  purchasedGiftCards     GiftCard[]         @relation("GiftCardPurchaser")
  campaignUsages         DiscountCampaignUsage[]
  preferences   UserPreference?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([expiresAt])
}

model OtpVerificationCode {
  id          String   @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model Collection {
  id          String    @id
  name        String
  namePersian String?
  products    Product[]
}

model Product {
  id                String          @id
  name              String
  namePersian       String
  introVideoUrl     String?
  price             Int
  listPrice         Int?
  discountPercent   Int?
  discountEndsAt    DateTime?
  image             String
  category          String
  metal             String
  stone             String
  stoneShape        String
  engravingType     String
  availability      String
  stock             Int             @default(1)
  condition         String          @default("new")
  featured          Boolean         @default(false)
  bestseller        Boolean         @default(false)
  initialSalesCount Int?
  collectionId      String?
  collection        Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  listing           ProductListing?
  preOwnedInfo      PreOwnedInfo?
  images            ProductImage[]
  orderItems        OrderItem[]
  comments          ProductComment[]
  questions         ProductQuestion[]
  ugcMedia          ProductUgcMedia[]
  authenticityVerifications ProductAuthenticityVerification[]
  backInStockAlerts BackInStockAlert[]
  homeSliderItems   HomeSliderItem[]
  ringCustomizationConfig ProductRingCustomizationConfig?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([collectionId])
  @@index([condition])
  @@index([bestseller])
  @@index([featured])
}

model ProductUgcMedia {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  orderId    String?
  mediaUrl   String
  mediaType  String
  caption    String?
  status     String   @default("pending")
  approvedAt DateTime?
  rejectedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order      Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
}

model ProductAuthenticityVerification {
  id                  String   @id @default(cuid())
  pieceCodeInput      String
  pieceCodeNormalized String
  status              String
  productId           String?
  ipHash              String?
  userAgent           String?
  verifiedAt          DateTime @default(now())
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([pieceCodeNormalized, verifiedAt])
  @@index([status, verifiedAt])
  @@index([productId, verifiedAt])
}

model BackInStockAlert {
  id                 String   @id @default(cuid())
  productId          String
  userId             String?
  name               String?
  channel            String
  contact            String
  status             String   @default("pending")
  sourceAvailability String?
  requestedAt        DateTime @default(now())
  notifiedAt         DateTime?
  notifyAttempts     Int      @default(0)
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([productId, channel, contact])
  @@index([productId, status, requestedAt])
  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model AbandonedCartRecovery {
  id              String   @id @default(cuid())
  token           String   @unique
  userId          String?
  name            String?
  channel         String
  contact         String
  status          String   @default("pending")
  cartSnapshot    Json
  shippingSnapshot Json?
  checkoutPath    String   @default("/cart?step=checkout")
  lastActivityAt  DateTime @default(now())
  nextReminderAt  DateTime?
  reminderSentAt  DateTime?
  reminderCount   Int      @default(0)
  recoveredAt     DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([channel, contact])
  @@index([status, lastActivityAt])
  @@index([status, nextReminderAt])
  @@index([userId, updatedAt])
}

model BundleOffer {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  discountType       String
  discountValue      Int
  requiredProductIds Json
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([active, updatedAt])
}

model ReferralInvite {
  id               String   @id @default(cuid())
  inviterId        String
  inviteeId        String   @unique
  referralCodeUsed String
  status           String   @default("registered")
  antiFraudReason  String?
  inviteeFirstOrderId String?
  inviterReward    Int      @default(0)
  inviteeReward    Int      @default(0)
  inviteIpHash     String?
  createdAt        DateTime @default(now())
  rewardedAt       DateTime?
  updatedAt        DateTime @updatedAt
  inviter          User     @relation("ReferralInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee          User     @relation("ReferralInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviterId, createdAt])
  @@index([status, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, sortOrder])
}

model ProductListing {
  productId String  @id
  tier      String
  headline  String
  details   Json
  extraTags Json?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PreOwnedInfo {
  productId            String  @id
  originalPrice        Int
  depreciationPercent  Int
  grade                String
  certifiedRefurbished Boolean
  canRemake            Boolean
  buybackRatePercent   Int
  story                String?
  product              Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id           String      @id
  userId       String
  orderType    String      @default("product")
  status       String
  total        Int
  subtotalList Int?
  totalFurooh  Int?
  bundleDiscount Int?
  appliedBundles Json?
  promoCode          String?
  giftCardCode       String?
  giftCardAppliedAmount Int?
  loyaltyTier        String?
  loyaltyDiscountAmount Int?
  loyaltyPointsEarned Int?
  giftCardPurchaseAmount Int?
  giftCardRecipientName String?
  giftCardRecipientContact String?
  paymentMethod     String?
  installmentMonths Int?
  installmentAmount Int?
  shippingName       String?
  shippingPhone      String?
  shippingProvince   String?
  shippingCity       String?
  shippingAddress    String?
  shippingPostalCode String?
  orderNote          String?
  shippingMethod     String?
  shippingCost       Int         @default(0)
  trackingCode       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  payment          Payment?
  notifications    OrderNotification[]
  journeyEvents    AutomatedJourneyEvent[]
  maintenanceReminders MaintenanceReminder[]
  ugcMedia         ProductUgcMedia[]
  supportRequests  SupportRequest[]
  returns          OrderReturn[]
  giftCardTransactions GiftCardTransaction[]
  purchasedGiftCard GiftCard?
  campaignId             String?
  campaignDiscountAmount Int?
  campaign               DiscountCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignUsages         DiscountCampaignUsage[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([campaignId])
}

model OrderReturn {
  id               String   @id @default(cuid())
  orderId          String
  userId           String?
  supportRequestId String?  @unique
  reason           String
  reasonDetail     String?
  status           String   @default("requested")
  refundableAmount Int      @default(0)
  internalNotes    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  supportRequest   SupportRequest? @relation(fields: [supportRequestId], references: [id], onDelete: SetNull)
  items            OrderReturnItem[]
  statusHistory    OrderReturnStatusHistory[]

  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderReturnItem {
  id          String      @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Int
  return      OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
}

model OrderReturnStatusHistory {
  id          String      @id @default(cuid())
  returnId    String
  fromStatus  String?
  toStatus    String
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())
  return      OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, createdAt])
}

model GiftCard {
  id               String   @id @default(cuid())
  code             String   @unique
  initialAmount    Int
  remainingAmount  Int
  active           Boolean  @default(true)
  expiresAt        DateTime?
  note             String?
  recipientName    String?
  recipientContact String?
  purchaserUserId  String?
  orderId          String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  purchaser        User?    @relation("GiftCardPurchaser", fields: [purchaserUserId], references: [id], onDelete: SetNull)
  order            Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  transactions     GiftCardTransaction[]

  @@index([active, remainingAmount])
  @@index([purchaserUserId, createdAt])
}

model GiftCardTransaction {
  id          String   @id @default(cuid())
  giftCardId  String
  orderId     String?
  type        String
  amount      Int
  description String?
  createdAt   DateTime @default(now())
  giftCard    GiftCard @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([giftCardId, createdAt])
  @@index([orderId, createdAt])
  @@unique([orderId, type])
}

model SupportRequest {
  id            String   @id @default(cuid())
  userId        String?
  orderId       String?
  kind          String
  category      String
  fullName      String
  phone         String
  email         String?
  message       String
  internalNotes String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderReturn   OrderReturn?

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String        @unique
  gateway      String        @default("zarinpal")
  authority    String?       @unique
  amountRial   Int
  status       String        @default("pending")
  refId        String?
  cardPan      String?
  fee          Int?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  verifiedAt   DateTime?
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logs         PaymentLog[]

  @@index([status, createdAt])
}

model PaymentLog {
  id        String   @id @default(cuid())
  paymentId String?
  orderId   String?
  level     String
  event     String
  message   String?
  meta      Json?
  createdAt DateTime @default(now())
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
}

model CustomizerQuoteRequest {
  id              String   @id
  userId          String
  status          String   @default("pending-quote")
  liveStage       String   @default("received")
  etaDays         Int?
  etaUpdatedAt    DateTime?
  workshopLiveMessage String?
  title           String
  configuration   Json
  estimateTotal   Int
  customerNote    String?
  quotedTotal     Int?
  workshopReply   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model OrderNotification {
  id          String   @id @default(cuid())
  orderId     String
  kind        String
  channel     String
  recipient   String
  fingerprint String?
  status      String
  detail      String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind, channel])
  @@index([orderId, createdAt])
}

model AutomatedJourneyEvent {
  id          String   @id @default(cuid())
  journey     String
  channel     String
  recipient   String
  fingerprint String
  status      String
  detail      String?
  userId      String?
  orderId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sentAt      DateTime?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([journey, channel, fingerprint])
  @@index([journey, status, createdAt])
  @@index([userId, createdAt])
  @@index([orderId, createdAt])
}

model MaintenanceReminder {
  id            String   @id @default(cuid())
  userId        String?
  orderId       String
  kind          String
  channel       String
  recipient     String
  status        String   @default("pending")
  dueAt         DateTime
  sentAt        DateTime?
  notifyAttempts Int     @default(0)
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind, channel])
  @@index([status, dueAt])
  @@index([userId, dueAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  name            String
  price           Int
  listPrice       Int?
  quantity        Int
  image           String
  availability    String?
  customizerState Json?
  ringPurchaseCustomization Json?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnItems     OrderReturnItem[]

  @@index([orderId])
  @@index([productId])
}

model ProductComment {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  body       String
  rating     Int
  ratingBuildQuality Int
  ratingBeauty Int
  ratingValue Int
  ratingPackaging Int
  mediaUrl   String?
  mediaType  String?
  isVerifiedBuyer Boolean @default(false)
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([userId])
}

model ProductQuestion {
  id         String                  @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  body       String
  status     String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers    ProductQuestionAnswer[]

  @@index([productId, status, createdAt])
  @@index([userId])
}

model ProductQuestionAnswer {
  id         String          @id @default(cuid())
  questionId String
  userId     String?
  authorName String
  body       String
  status     String
  isOfficial Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([questionId, status, createdAt])
  @@index([userId])
}

model PromoCode {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  type             String
  value            Int
  minSubtotal      Int      @default(0)
  replacesSiteWide Boolean  @default(false)
  active           Boolean  @default(true)
  aliases          Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  linkedCampaigns  DiscountCampaign[]

  @@index([active, code])
}

model DiscountCampaign {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  title                 String
  description           String?
  discountType          String
  discountValue         Int
  minSubtotal           Int      @default(0)
  targetScope           String   @default("all")
  targetProductIds      Json     @default("[]")
  targetCollectionIds   Json     @default("[]")
  startsAt              DateTime?
  endsAt                DateTime?
  active                Boolean  @default(true)
  priority              Int      @default(0)
  replacesSiteWide      Boolean  @default(false)
  linkedPromoCodeId     String?
  bannerEnabled         Boolean  @default(false)
  bannerBadge           String?
  bannerTitle           String?
  bannerSubtitle        String?
  bannerCtaLabel        String?
  bannerCtaHref         String?
  bannerImageUrl        String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  linkedPromoCode       PromoCode? @relation(fields: [linkedPromoCodeId], references: [id], onDelete: SetNull)
  orders                Order[]
  usages                DiscountCampaignUsage[]

  @@index([active, startsAt, endsAt])
  @@index([slug])
  @@index([linkedPromoCodeId])
}

model DiscountCampaignUsage {
  id             String           @id @default(cuid())
  campaignId     String
  orderId        String
  userId         String?
  discountAmount Int
  orderSubtotal  Int?
  createdAt      DateTime         @default(now())
  campaign       DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  order          Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([orderId, campaignId])
  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
}

model TradeInSubmission {
  id                     String   @id @default(cuid())
  fullName               String
  phone                  String
  ringDescription        String
  estimatedOriginalPrice Int
  notes                  String?
  internalNotes          String?
  wantsRemake            Boolean
  status                 String   @default("pending")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status, createdAt])
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  body            String
  coverImage      String?
  authorName      String?
  status          String    @default("draft")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
}

model HomeSliderItem {
  id        String   @id @default(cuid())
  productId String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId])
  @@index([active, sortOrder])
}

model HomeBannerSettings {
  id                 String    @id @default("default")
  enabled            Boolean   @default(true)
  badge              String
  title              String
  subtitle           String
  percent            Int       @default(20)
  countdownEnabled   Boolean   @default(true)
  countdownEndsAt    DateTime?
  ctaLabel           String?
  ctaHref            String    @default("/shop")
  headerStripEnabled Boolean   @default(false)
  headerStripMode    String    @default("text")
  headerStripImageUrl String?
  headerStripBadge   String    @default("")
  headerStripTitle   String    @default("")
  headerStripSubtitle String   @default("")
  headerStripCtaLabel String?
  headerStripCtaHref String    @default("/shop")
  updatedAt          DateTime  @updatedAt
}

model HomeTestimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  text      String
  rating    Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeInstagramPost {
  id        String   @id @default(cuid())
  image     String
  likes     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductRingCustomizationConfig {
  id                       String   @id @default(cuid())
  productId                String   @unique
  enabled                  Boolean  @default(false)
  sizeBase                 Int?
  sizeMin                  Int?
  sizeMax                  Int?
  sizePricingMode          String   @default("free")
  sizeFixedDelta           Int      @default(0)
  sizeStepAmount           Int      @default(0)
  shankEnabled             Boolean  @default(false)
  shankDefaultIncluded     Boolean  @default(false)
  shankDefaultRemovalCredit Int     @default(0)
  stoneEnabled             Boolean  @default(false)
  stoneDefaultIncluded     Boolean  @default(false)
  stoneDefaultRemovalCredit Int     @default(0)
  baseLeadTimeDays         Int      @default(0)
  sizeLeadTimeDays         Int      @default(0)
  shankLeadTimeDays        Int      @default(0)
  stoneLeadTimeDays        Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  product                  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allowedShankArtisans     ProductAllowedShankArtisan[]
  allowedShankPatterns     ProductAllowedShankPattern[]
  allowedStoneArtisans     ProductAllowedStoneArtisan[]
  allowedStoneTexts        ProductAllowedStoneText[]
  allowedScriptStyles      ProductAllowedScriptStyle[]

  @@index([enabled, updatedAt])
}

model RingCustomizationArtisan {
  id              String   @id @default(cuid())
  name            String
  scope           String
  active          Boolean  @default(true)
  priceMode       String   @default("fixed")
  priceAdd        Int      @default(0)
  priceMultiplier Float    @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  allowedInShank  ProductAllowedShankArtisan[]
  allowedInStone  ProductAllowedStoneArtisan[]

  @@index([scope, active, updatedAt])
}

model RingCustomizationShankPattern {
  id              String   @id @default(cuid())
  title           String
  imageUrl        String?
  complexityLevel Int      @default(1)
  priceAdd        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  allowedInConfig ProductAllowedShankPattern[]

  @@index([active, updatedAt])
}

model RingCustomizationStoneText {
  id              String   @id @default(cuid())
  text            String
  meaning         String?
  previewImageUrl String?
  priceAdd        Int      @default(0)
  active          Boolean  @default(true)
  searchKeywords  Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  allowedInConfig ProductAllowedStoneText[]
  allowedScripts  StoneTextAllowedScript[]

  @@index([active, updatedAt])
}

model RingCustomizationScriptStyle {
  id              String   @id @default(cuid())
  title           String
  previewImageUrl String?
  priceAdd        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  allowedInConfig ProductAllowedScriptStyle[]
  allowedTexts    StoneTextAllowedScript[]

  @@index([active, updatedAt])
}

model ProductAllowedShankArtisan {
  configId   String
  artisanId  String
  config     ProductRingCustomizationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  artisan    RingCustomizationArtisan       @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@id([configId, artisanId])
  @@index([artisanId])
}

model ProductAllowedShankPattern {
  configId   String
  patternId  String
  config     ProductRingCustomizationConfig  @relation(fields: [configId], references: [id], onDelete: Cascade)
  pattern    RingCustomizationShankPattern   @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([configId, patternId])
  @@index([patternId])
}

model ProductAllowedStoneArtisan {
  configId   String
  artisanId  String
  config     ProductRingCustomizationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  artisan    RingCustomizationArtisan       @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@id([configId, artisanId])
  @@index([artisanId])
}

model ProductAllowedStoneText {
  configId  String
  textId    String
  config    ProductRingCustomizationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  text      RingCustomizationStoneText     @relation(fields: [textId], references: [id], onDelete: Cascade)

  @@id([configId, textId])
  @@index([textId])
}

model ProductAllowedScriptStyle {
  configId  String
  styleId   String
  config    ProductRingCustomizationConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  style     RingCustomizationScriptStyle   @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([configId, styleId])
  @@index([styleId])
}

model StoneTextAllowedScript {
  textId   String
  styleId  String
  text     RingCustomizationStoneText   @relation(fields: [textId], references: [id], onDelete: Cascade)
  style    RingCustomizationScriptStyle @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([textId, styleId])
  @@index([styleId])
}

model SiteSettings {
  id                     String   @id @default("default")
  brandName              String
  brandTagline           String
  shortDescription       String?
  logoUrl                String?
  contactPhone           String?
  contactPhoneSecondary  String?
  socialInstagram        String?
  socialBale             String?
  socialEita             String?
  socialTelegram         String?
  socialWhatsapp         String?
  socialTwitter          String?
  socialYoutube          String?
  seoTitle               String?
  seoDescription         String?
  seoOgImageUrl          String?
  paymentGatewayEnabled  Boolean  @default(true)
  paymentProvider        String   @default("zarinpal")
  zarinpalMerchantId     String?
  zarinpalSandbox        Boolean  @default(true)
  smsEnabled             Boolean  @default(true)
  smsProvider            String   @default("kavenegar")
  updatedAt              DateTime @updatedAt
}

model UserPreference {
  userId             String   @id
  cartItems          Json?
  wishlistIds        Json?
  wishlistPriceWatch Json?
  savedDesigns       Json?
  compareProductIds  Json?
  recentlyViewedIds  Json?
  promoCode          String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PriceDropUnsubscribeToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  channel   String
  contact   String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, contact])
  @@index([userId, active])
}

model AdminAuditLog {
  id         String   @id
  createdAt  DateTime @default(now())
  action     String
  method     String
  route      String
  entityType String?
  entityId   String?
  summary    String?
  payload    String?
  actorId    String
  actorName  String?
  actorPhone String?
  actorRole  String?
  ip         String?
  userAgent  String?

  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@index([entityType])
  @@index([actorId])
}
