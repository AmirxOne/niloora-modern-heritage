generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String               @id @default(cuid())
  name          String
  phone         String               @unique
  passwordHash  String
  firstName     String?
  lastName      String?
  birthDate     DateTime?
  postalCode    String?
  addressLine   String?
  province      String?
  city          String?
  nationalCode  String?
  landlinePhone String?
  gender        String?
  role          String               @default("user")
  memberSince   DateTime             @default(now())
  tier          String?
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  email         String?              @unique
  orders                 Order[]
  supportRequests        SupportRequest[]
  customizerQuoteRequests CustomizerQuoteRequest[]
  comments               ProductComment[]
  productQuestions       ProductQuestion[]
  productQuestionAnswers ProductQuestionAnswer[]
  preferences   UserPreference?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([expiresAt])
}

model OtpVerificationCode {
  id          String   @id @default(cuid())
  phone       String
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model Collection {
  id          String    @id
  name        String
  namePersian String?
  products    Product[]
}

model Product {
  id                String          @id
  name              String
  namePersian       String
  introVideoUrl     String?
  price             Int
  listPrice         Int?
  discountPercent   Int?
  discountEndsAt    DateTime?
  image             String
  category          String
  metal             String
  stone             String
  stoneShape        String
  engravingType     String
  availability      String
  stock             Int             @default(1)
  condition         String          @default("new")
  featured          Boolean         @default(false)
  bestseller        Boolean         @default(false)
  initialSalesCount Int?
  collectionId      String?
  collection        Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  listing           ProductListing?
  preOwnedInfo      PreOwnedInfo?
  images            ProductImage[]
  orderItems        OrderItem[]
  comments          ProductComment[]
  questions         ProductQuestion[]
  homeSliderItems   HomeSliderItem[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([collectionId])
  @@index([condition])
  @@index([bestseller])
  @@index([featured])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, url])
  @@index([productId, sortOrder])
}

model ProductListing {
  productId String  @id
  tier      String
  headline  String
  details   Json
  extraTags Json?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PreOwnedInfo {
  productId            String  @id
  originalPrice        Int
  depreciationPercent  Int
  grade                String
  certifiedRefurbished Boolean
  canRemake            Boolean
  buybackRatePercent   Int
  story                String?
  product              Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id           String      @id
  userId       String
  status       String
  total        Int
  subtotalList Int?
  totalFurooh  Int?
  promoCode          String?
  shippingName       String?
  shippingPhone      String?
  shippingProvince   String?
  shippingCity       String?
  shippingAddress    String?
  shippingPostalCode String?
  orderNote          String?
  shippingMethod     String?
  shippingCost       Int         @default(0)
  trackingCode       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items            OrderItem[]
  payment          Payment?
  notifications    OrderNotification[]
  supportRequests  SupportRequest[]

  @@index([userId, createdAt])
  @@index([status])
}

model SupportRequest {
  id            String   @id @default(cuid())
  userId        String?
  orderId       String?
  kind          String
  category      String
  fullName      String
  phone         String
  email         String?
  message       String
  internalNotes String?
  status        String   @default("pending")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([kind, createdAt])
  @@index([userId, createdAt])
  @@index([orderId])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String        @unique
  gateway      String        @default("zarinpal")
  authority    String?       @unique
  amountRial   Int
  status       String        @default("pending")
  refId        String?
  cardPan      String?
  fee          Int?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  verifiedAt   DateTime?
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  logs         PaymentLog[]

  @@index([status, createdAt])
}

model PaymentLog {
  id        String   @id @default(cuid())
  paymentId String?
  orderId   String?
  level     String
  event     String
  message   String?
  meta      Json?
  createdAt DateTime @default(now())
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([paymentId, createdAt])
  @@index([orderId, createdAt])
}

model CustomizerQuoteRequest {
  id              String   @id
  userId          String
  status          String   @default("pending-quote")
  title           String
  configuration   Json
  estimateTotal   Int
  customerNote    String?
  quotedTotal     Int?
  workshopReply   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model OrderNotification {
  id          String   @id @default(cuid())
  orderId     String
  kind        String
  channel     String
  recipient   String
  fingerprint String?
  status      String
  detail      String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind, channel])
  @@index([orderId, createdAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?
  name            String
  price           Int
  listPrice       Int?
  quantity        Int
  image           String
  availability    String?
  customizerState Json?
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model ProductComment {
  id         String   @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  body       String
  rating     Int
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, status, createdAt])
  @@index([userId])
}

model ProductQuestion {
  id         String                  @id @default(cuid())
  productId  String
  userId     String?
  authorName String
  body       String
  status     String
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  product    Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  answers    ProductQuestionAnswer[]

  @@index([productId, status, createdAt])
  @@index([userId])
}

model ProductQuestionAnswer {
  id         String          @id @default(cuid())
  questionId String
  userId     String?
  authorName String
  body       String
  status     String
  isOfficial Boolean         @default(false)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  question   ProductQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([questionId, status, createdAt])
  @@index([userId])
}

model PromoCode {
  id               String   @id @default(cuid())
  code             String   @unique
  label            String
  type             String
  value            Int
  minSubtotal      Int      @default(0)
  replacesSiteWide Boolean  @default(false)
  active           Boolean  @default(true)
  aliases          Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active, code])
}

model TradeInSubmission {
  id                     String   @id @default(cuid())
  fullName               String
  phone                  String
  ringDescription        String
  estimatedOriginalPrice Int
  notes                  String?
  internalNotes          String?
  wantsRemake            Boolean
  status                 String   @default("pending")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status, createdAt])
}

model Post {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  body            String
  coverImage      String?
  authorName      String?
  status          String    @default("draft")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, publishedAt])
}

model HomeSliderItem {
  id        String   @id @default(cuid())
  productId String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId])
  @@index([active, sortOrder])
}

model HomeBannerSettings {
  id               String    @id @default("default")
  enabled          Boolean   @default(true)
  badge            String
  title            String
  subtitle         String
  percent          Int       @default(20)
  countdownEnabled Boolean   @default(true)
  countdownEndsAt  DateTime?
  ctaLabel         String?
  ctaHref          String    @default("/shop")
  updatedAt        DateTime  @updatedAt
}

model HomeTestimonial {
  id        String   @id @default(cuid())
  name      String
  location  String
  text      String
  rating    Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HomeInstagramPost {
  id        String   @id @default(cuid())
  image     String
  likes     Int      @default(0)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPreference {
  userId             String   @id
  cartItems          Json?
  wishlistIds        Json?
  savedDesigns       Json?
  compareProductIds  Json?
  recentlyViewedIds  Json?
  promoCode          String?
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramProduct {
  id                String   @id @default(cuid())
  title             String?
  description       String   @default("")
  tags              Json
  attributes        Json
  images            Json
  telegramMessageId Int
  telegramDate      DateTime
  sourceChannel     String
  rawText           String?
  hasMedia          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([sourceChannel, telegramMessageId])
  @@index([sourceChannel, telegramDate])
}

model TelegramSyncState {
  channel         String   @id
  lastMessageId   Int      @default(0)
  lastSyncedAt    DateTime?
  listenerEnabled Boolean  @default(false)
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
